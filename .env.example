# Este projeto é um site estático (sem build step), então as credenciais
# do Supabase ficam hardcoded direto em js/supabaseClient.js — a anon key
# é pública por design, quem protege os dados é a RLS configurada no
# schema.sql, não o segredo dessa chave.
#
# Este arquivo é só uma referência de quais valores você precisa ter em
# mãos (Project Settings > API no dashboard do Supabase). Não é lido
# automaticamente por nada no código.

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA_ANON_KEY_AQUI
